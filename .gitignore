# Credentials — never commit tokens
credentials.json

# Shared pinned Lean configuration is versioned; caches stay local.
.lake/
*.olean
*.olean.private
*.olean.server
*.ilean
*.trace

# OS noise
.DS_Store
Thumbs.db
Desktop.ini
__pycache__/
*.py[cod]
.pytest_cache/
# An unexpanded Windows environment variable created this cache directory.
%SystemDrive%/

# Local secrets and virtual environments.
.env
.env.*
!.env.example
.venv/
venv/

# Explicitly private release material and reproducible ZIP staging copies.
/release/*/AUTHOR_REVIEW.md
/release/*/staging/

# Scratch Lean probes (tmp/*.lean are throwaway import/syntax checks)
tmp/

# Local API response dumps that are regenerated on every submit.
# `**/` (not `*/`) so that logs nested at any depth are covered too.
missions/**/*.log

# Script scratch payloads (written by seed/set helpers, no lasting value)
missions/**/item-tmp.json
missions/**/milestone-tmp.json

# Generated finite certificates (Euler-gamma / Sondow-Rosser line).
# These are machine-generated, tens of MB each, and dominate the repo size.
# Their generators, hashes and conclusions are recorded in
# missions/euler-gamma/sondow/ROSSER-FINITE-CERTIFICATES.md, so nothing is lost.
# Regenerate into tmp/ instead.
Solutions/SondowRosserMiddle*.lean
Solutions/SondowRosserMiddle*.json
missions/euler-gamma/sondow/continuation/failed-recursion-*.lean

# Machine-written diagnostics for the balanced-largest-block search. Each is a
# few lines of Lean wrapping a ~700 KB literal; conclusions are recorded in
# missions/euler-gamma/sondow/.
balanced-largest-block-*.lean

# 3SUM publication: keep final proofs/receipts in Git; generated extraction
# dumps and repeated full graph responses remain local, indexed by SHA-256.
/missions/3sum-1960614/submission-bigospeedrun/
/missions/3sum-1960614/verification/machine-frontier-readback/
/missions/3sum-1960614/verification/*-machine-live-graph.json
/missions/3sum-1960614/verification/*-targeted-parent-graph.json
/missions/3sum-1960614/verification/*-targeted-child-graph.json
/missions/3sum-1960614/verification/extended-reuse-native.jsonl
/missions/3sum-1960614/verification/reuse-interfaces-native.jsonl
/missions/3sum-1960614/verification/extended-reuse-public.jsonl
/missions/3sum-1960614/verification/machine-platform-types-native.json
/missions/3sum-1960614/verification/public-theorem-probe-types.json
/missions/3sum-1960614/verification/machine-scope-contexts.json
/missions/3sum-1960614/verification/extended-reuse-compact-index.json
/missions/3sum-1960614/verification/reuse-interfaces-platform.jsonl
/missions/3sum-1960614/verification/machine-node-classification.json
/missions/3sum-1960614/verification/server-import-originals/
/missions/3sum-1960614/verification/server-macro-originals/
/missions/3sum-1960614/verification/server-proof-originals/
/missions/3sum-1960614/verification/server-macro-v1-rendered/
/missions/3sum-1960614/verification/obsolete-platform-staging/

# Preserve compact root readbacks alongside the full final graph audit.
!/missions/3sum-1960614/verification/main-root-machine-live-graph.json
!/missions/3sum-1960614/verification/main-root-final-machine-live-graph.json
!/missions/3sum-1960614/verification/ThreeSum1960614_costs_solve_3sum-machine-live-graph.json
