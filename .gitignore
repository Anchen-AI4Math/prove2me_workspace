# Credentials — never commit tokens
credentials.json

# Shared pinned Lean configuration is versioned; caches stay local.
.lake/
*.olean
*.olean.private
*.olean.server
*.ilean
*.trace

# OS noise
.DS_Store
Thumbs.db
Desktop.ini
__pycache__/
*.py[cod]
.pytest_cache/
# An unexpanded Windows environment variable created this cache directory.
%SystemDrive%/

# Local secrets and virtual environments.
.env
.env.*
!.env.example
.venv/
venv/

# Explicitly private release material and reproducible ZIP staging copies.
/release/*/AUTHOR_REVIEW.md
/release/*/staging/

# Scratch Lean probes (tmp/*.lean are throwaway import/syntax checks)
tmp/

# Local API response dumps that are regenerated on every submit.
# `**/` (not `*/`) so that logs nested at any depth are covered too.
missions/**/*.log

# Script scratch payloads (written by seed/set helpers, no lasting value)
missions/**/item-tmp.json
missions/**/milestone-tmp.json

# Generated finite certificates (Euler-gamma / Sondow-Rosser line).
# These are machine-generated, tens of MB each, and dominate the repo size.
# Their generators, hashes and conclusions are recorded in
# missions/euler-gamma/sondow/ROSSER-FINITE-CERTIFICATES.md, so nothing is lost.
# Regenerate into tmp/ instead.
Solutions/SondowRosserMiddle*.lean
Solutions/SondowRosserMiddle*.json
missions/euler-gamma/sondow/continuation/failed-recursion-*.lean

# Machine-written diagnostics for the balanced-largest-block search. Each is a
# few lines of Lean wrapping a ~700 KB literal; conclusions are recorded in
# missions/euler-gamma/sondow/.
balanced-largest-block-*.lean
