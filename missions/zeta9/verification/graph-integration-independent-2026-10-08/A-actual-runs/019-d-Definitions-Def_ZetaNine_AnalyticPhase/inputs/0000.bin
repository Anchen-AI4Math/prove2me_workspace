  "all29_original_whole_definitions": [
    {
      "name": "numerator",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.numerator",
      "body": "def numerator (n : ℕ) (t : ℚ) : ℚ :=\n  (n.factorial : ℚ) ^ 7 *\n    (∏ i ∈ range n, (t - ((i : ℚ) + 1))) *\n    (∏ i ∈ range n, (t + n + ((i : ℚ) + 1)))",
      "source_module": "CoefficientMap"
    },
    {
      "name": "poleProduct",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.poleProduct",
      "body": "def poleProduct (n : ℕ) (t : ℚ) : ℚ :=\n  ∏ k ∈ range (n + 1), (t + k)",
      "source_module": "CoefficientMap"
    },
    {
      "name": "actualR",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.actualR",
      "body": "def actualR (n : ℕ) (t : ℚ) : ℚ := numerator n t / poleProduct n t ^ 9",
      "source_module": "CoefficientMap"
    },
    {
      "name": "clearedPoleProduct",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.clearedPoleProduct",
      "body": "def clearedPoleProduct (n j : ℕ) (t : ℚ) : ℚ :=\n  ∏ k ∈ (range (n + 1)).erase j, (t + k)",
      "source_module": "CoefficientMap"
    },
    {
      "name": "clearedR",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.clearedR",
      "body": "def clearedR (n j : ℕ) (t : ℚ) : ℚ :=\n  numerator n t / clearedPoleProduct n j t ^ 9",
      "source_module": "CoefficientMap"
    },
    {
      "name": "leadingPoleCoefficient",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.leadingPoleCoefficient",
      "body": "def leadingPoleCoefficient (n j : ℕ) : ℚ := clearedR n j (-(j : ℚ))",
      "source_module": "CoefficientMap"
    },
    {
      "name": "weightedR",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.weightedR",
      "body": "def weightedR (n : ℕ) (W : ℚ[X]) (t : ℚ) : ℚ :=\n  actualR n t * W.eval (t * (t + n))",
      "source_module": "CoefficientMap"
    },
    {
      "name": "clearedWeightedR",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.clearedWeightedR",
      "body": "def clearedWeightedR (n j : ℕ) (W : ℚ[X]) (t : ℚ) : ℚ :=\n  clearedR n j t * W.eval (t * (t + n))",
      "source_module": "CoefficientMap"
    },
    {
      "name": "weightedLeadingPoleCoefficient",
      "namespace": "ZetaNine.CoefficientMap",
      "full_name": "ZetaNine.CoefficientMap.weightedLeadingPoleCoefficient",
      "body": "def weightedLeadingPoleCoefficient (n j : ℕ) (W : ℚ[X]) : ℚ :=\n  clearedWeightedR n j W (-(j : ℚ))",
      "source_module": "CoefficientMap"
    },
    {
      "name": "phase",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.phase",
      "body": "def phase (x : ℝ) : ℝ :=\n  10 * x * Real.log x + (x + 2) * Real.log (x + 2) -\n    (x - 1) * Real.log (x - 1) - 10 * (x + 1) * Real.log (x + 1)",
      "source_module": "missions.zeta9.formalization.AnalyticPhase"
    },
    {
      "name": "phaseRatio",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.phaseRatio",
      "body": "def phaseRatio (x : ℝ) : ℝ := (x + 2) * x ^ 10 / ((x - 1) * (x + 1) ^ 10)",
      "source_module": "missions.zeta9.formalization.AnalyticPhase"
    },
    {
      "name": "phaseSlope",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.phaseSlope",
      "body": "def phaseSlope (x : ℝ) : ℝ :=\n  10 * Real.log x + Real.log (x + 2) - Real.log (x - 1) - 10 * Real.log (x + 1)",
      "source_module": "missions.zeta9.formalization.AnalyticPhase"
    },
    {
      "name": "upperSlopeConstant",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.upperSlopeConstant",
      "body": "def upperSlopeConstant : ℝ := (301 / 100 : ℝ) * (101 / 201 : ℝ) ^ 10",
      "source_module": "missions.zeta9.formalization.AnalyticPhase"
    },
    {
      "name": "smoothPhaseGap",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.smoothPhaseGap",
      "body": "def smoothPhaseGap (x : ℝ) : ℝ :=\n  10 * x * Real.log x + (x + 2) * Real.log (x + 2) -\n    10 * (x + 1) * Real.log (x + 1) - phase 1 -\n      (x - 1) * (1 + Real.log upperSlopeConstant)",
      "source_module": "AnalyticPhaseUpperBound"
    },
    {
      "name": "smoothPhaseSlope",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.smoothPhaseSlope",
      "body": "def smoothPhaseSlope (x : ℝ) : ℝ :=\n  10 * Real.log x + Real.log (x + 2) - 10 * Real.log (x + 1) -\n    Real.log upperSlopeConstant",
      "source_module": "AnalyticPhaseUpperBound"
    },
    {
      "name": "smoothPhaseRatio",
      "namespace": "ZetaNine.AnalyticPhase",
      "full_name": "ZetaNine.AnalyticPhase.smoothPhaseRatio",
      "body": "def smoothPhaseRatio (x : ℝ) : ℝ :=\n  (x + 2) * (x / (x + 1)) ^ 10",
      "source_module": "AnalyticPhaseUpperBound"
    },
    {
      "name": "actualMomentTerm",
      "namespace": "ZetaNine.AnalyticMomentBounds",
      "full_name": "ZetaNine.AnalyticMomentBounds.actualMomentTerm",
      "body": "def actualMomentTerm (n r k : ℕ) : ℝ :=\n  (CoefficientMap.actualR n (k : ℚ) : ℝ) *\n    ((k : ℝ) * ((k : ℝ) + (n : ℝ))) ^ r",
      "source_module": "AnalyticMomentBounds"
    },
    {
      "name": "actualMomentSequence",
      "namespace": "ZetaNine.AnalyticMomentBounds",
      "full_name": "ZetaNine.AnalyticMomentBounds.actualMomentSequence",
      "body": "def actualMomentSequence (n r m : ℕ) : ℝ := actualMomentTerm n r (m + 1)",
      "source_module": "AnalyticMomentBounds"
    },
    {
      "name": "actualMoment",
      "namespace": "ZetaNine.AnalyticMomentBounds",
      "full_name": "ZetaNine.AnalyticMomentBounds.actualMoment",
      "body": "def actualMoment (n r : ℕ) : ℝ := ∑' m : ℕ, actualMomentSequence n r m",
      "source_module": "AnalyticMomentBounds"
    },
    {
      "name": "tailPower",
      "namespace": "ZetaNine.AnalyticMomentBounds",
      "full_name": "ZetaNine.AnalyticMomentBounds.tailPower",
      "body": "def tailPower (n r : ℕ) : ℕ := 7 * n + 9 - 2 * r",
      "source_module": "AnalyticMomentBounds"
    },
    {
      "name": "tailCoefficient",
      "namespace": "ZetaNine.AnalyticMomentBounds",
      "full_name": "ZetaNine.AnalyticMomentBounds.tailCoefficient",
      "body": "def tailCoefficient (n r : ℕ) : ℝ :=\n  (n.factorial : ℝ) ^ 7 * (2 : ℝ) ^ n * (3 / 2 : ℝ) ^ r",
      "source_module": "AnalyticMomentBounds"
    },
    {
      "name": "tailWeightConstant",
      "namespace": "ZetaNine.AnalyticUniformMomentBound",
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailWeightConstant",
      "body": "def tailWeightConstant (r : ℕ) : ℝ :=\n  (9 / 7 : ℝ) * (3 / 2 : ℝ) ^ r / (2 : ℝ) ^ (9 - 2 * r)",
      "source_module": "AnalyticUniformMomentBound"
    },
    {
      "name": "tailMajorant",
      "namespace": "ZetaNine.AnalyticUniformMomentBound",
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailMajorant",
      "body": "def tailMajorant (n r : ℕ) : ℝ :=\n  tailCoefficient n r / (2 * (n : ℝ)) ^ tailPower n r * (9 / 7 : ℝ) /\n    (n : ℝ) ^ (2 * r)",
      "source_module": "AnalyticUniformMomentBound"
    },
    {
      "name": "tailExponent",
      "namespace": "ZetaNine.AnalyticUniformMomentBound",
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailExponent",
      "body": "def tailExponent : ℝ := 7 + 6 * Real.log 2",
      "source_module": "AnalyticUniformMomentBound"
    },
    {
      "name": "momentBoundConstant",
      "namespace": "ZetaNine.AnalyticUniformMomentBound",
      "full_name": "ZetaNine.AnalyticUniformMomentBound.momentBoundConstant",
      "body": "def momentBoundConstant : ℝ := 5184 * Real.exp 18 + (729 / 224 : ℝ) * Real.exp 7",
      "source_module": "AnalyticUniformMomentBound"
    },
    {
      "name": "actualWeightedSequence",
      "namespace": "ZetaNine.AnalyticWeightedBound",
      "full_name": "ZetaNine.AnalyticWeightedBound.actualWeightedSequence",
      "body": "def actualWeightedSequence (n : ℕ) (W : ℚ[X]) (m : ℕ) : ℝ :=\n  (CoefficientMap.weightedR n W ((m + 1 : ℕ) : ℚ) : ℝ)",
      "source_module": "AnalyticWeightedBound"
    },
    {
      "name": "weightedCoefficientHeight",
      "namespace": "ZetaNine.AnalyticWeightedBound",
      "full_name": "ZetaNine.AnalyticWeightedBound.weightedCoefficientHeight",
      "body": "def weightedCoefficientHeight (n : ℕ) (W : ℚ[X]) : ℝ :=\n  ∑ r ∈ range 5, |(W.coeff r : ℝ)| * (n : ℝ) ^ (2 * r)",
      "source_module": "AnalyticWeightedBound"
    },
    {
      "name": "analyticPrefactor",
      "namespace": "ZetaNine.AnalyticWeightedBound",
      "full_name": "ZetaNine.AnalyticWeightedBound.analyticPrefactor",
      "body": "def analyticPrefactor (n : ℕ) : ℝ :=\n  momentBoundConstant * ((n : ℝ) + 1) ^ 10 * Real.exp (-(2641 / 250 : ℝ) * n)",
      "source_module": "AnalyticWeightedBound"
    },
    {
      "name": "uniformError",
      "namespace": "ZetaNine.AnalyticWeightedBound",
      "full_name": "ZetaNine.AnalyticWeightedBound.uniformError",
      "body": "def uniformError (n : ℕ) : ℝ :=\n  (Real.log momentBoundConstant + 10 * Real.log ((n : ℝ) + 1)) / (n : ℝ)",
      "source_module": "AnalyticWeightedBound"
    }
  ],
