    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.log_tailWeightConstant",
      "prefix": "theorem log_tailWeightConstant (r : ℕ) :\n    Real.log (tailWeightConstant r) = Real.log (9 / 7 : ℝ) +\n      (r : ℝ) * Real.log (3 / 2 : ℝ) -\n      ((9 - 2 * r : ℕ) : ℝ) * Real.log 2 :=",
      "sha256_utf8": "5d223e0fa7b49b9900482e81baa930a34a83c046b5ee61caf8a0f939b2d6fb2e"
    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.log_tailMajorant_identity",
      "prefix": "theorem log_tailMajorant_identity (n r : ℕ) (hn : 1 ≤ n) :\n    Real.log (tailMajorant n r) =\n      7 * Real.log (n.factorial : ℝ) + (n : ℝ) * Real.log 2 +\n      (r : ℝ) * Real.log (3 / 2 : ℝ) -\n      (tailPower n r : ℝ) * (Real.log 2 + Real.log (n : ℝ)) +\n      Real.log (9 / 7 : ℝ) - ((2 * r : ℕ) : ℝ) * Real.log (n : ℝ) :=",
      "sha256_utf8": "16b6defbea21ad69513c2072edfb34ad4cc8b5131adc2c96a3b1ffcd27520a15"
    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.log_tailMajorant_upper",
      "prefix": "theorem log_tailMajorant_upper (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    Real.log (tailMajorant n r) ≤ Real.log (tailWeightConstant r) + 7 -\n      tailExponent * n - 2 * Real.log (n : ℝ) :=",
      "sha256_utf8": "bed3989e23b834d2d35f011cb810358525713db85816fb3def313adc17da4eee"
    },
