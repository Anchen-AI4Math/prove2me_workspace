    {
      "full_name": "ZetaNine.AnalyticWeightedBound.actual_weighted_uniform_o_one",
      "prefix": "theorem actual_weighted_uniform_o_one :\n    ∃ ε : ℕ → ℝ, Tendsto ε atTop (𝓝 0) ∧\n      ∀ n : ℕ, 1 ≤ n → ∀ W : ℚ[X], W.natDegree ≤ 4 →\n        |∑' m : ℕ, actualWeightedSequence n W m| ≤\n          Real.exp ((-(2641 / 250 : ℝ) + ε n) * n) * weightedCoefficientHeight n W :=",
      "sha256_utf8": "ac72569a6ac3b53e6db3ed04ee8665c9d0581b6b35a07b6bfda117f6e4ddd316"
