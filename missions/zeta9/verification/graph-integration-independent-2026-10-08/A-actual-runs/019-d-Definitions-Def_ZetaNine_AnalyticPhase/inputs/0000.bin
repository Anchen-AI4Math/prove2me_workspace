      "prefix": "theorem actualWeightedSequence_eq_actual_moment_sum (n : ℕ) (W : ℚ[X])\n    (hW : W.natDegree ≤ 4) (m : ℕ) :\n    actualWeightedSequence n W m =\n      ∑ r ∈ range 5, (W.coeff r : ℝ) * actualMomentSequence n r m :=",
