      "full_name": "ZetaNine.AnalyticWeightedBound.changing_quartics_uniform_bound",
      "prefix": "theorem changing_quartics_uniform_bound (W : ℕ → ℚ[X])\n    (hW : ∀ n : ℕ, (W n).natDegree ≤ 4) :\n    ∀ n : ℕ, 1 ≤ n → |∑' m : ℕ, actualWeightedSequence n (W n) m| ≤\n      analyticPrefactor n * weightedCoefficientHeight n (W n) :=",
      "sha256_utf8": "8c2c48d7c37f3352a117f6bd826813494ffe7c3994aef8273bcca0a5545aebcf"
