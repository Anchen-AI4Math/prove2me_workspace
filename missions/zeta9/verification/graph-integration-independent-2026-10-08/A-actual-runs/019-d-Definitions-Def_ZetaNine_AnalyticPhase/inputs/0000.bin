      "prefix": "theorem actual_compact_moment_sum_bound (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    (∑ m ∈ range (2 * n - 1), actualMomentSequence n r m) ≤\n      5184 * Real.exp 18 * (n : ℝ) ^ 10 * (n : ℝ) ^ (2 * r) *\n        Real.exp (-(2641 / 250 : ℝ) * n) :=",
