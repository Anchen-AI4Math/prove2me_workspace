  "all_original_complete_headers": [
    {
      "full_name": "ZetaNine.CoefficientMap.poleProduct_factor",
      "prefix": "theorem poleProduct_factor (n j : ℕ) (hj : j ≤ n) (t : ℚ) :\n    poleProduct n t = (t + j) * clearedPoleProduct n j t :=",
      "sha256_utf8": "d7c03e8ba5fd64d9f27b0b905d6e5ea239698303dbe0f98721a35a3384f16502"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.poleProduct_ne_zero",
      "prefix": "theorem poleProduct_ne_zero (n : ℕ) (t : ℚ)\n    (ht : ∀ k ≤ n, t + (k : ℚ) ≠ 0) : poleProduct n t ≠ 0 :=",
      "sha256_utf8": "e32ad6ef9383517ceb0f00342b9363ed2ac795b30c22caea78d327a739f2d76c"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.clearedPoleProduct_ne_zero",
      "prefix": "theorem clearedPoleProduct_ne_zero (n j : ℕ) :\n    clearedPoleProduct n j (-(j : ℚ)) ≠ 0 :=",
      "sha256_utf8": "358b42ef508514219039829b0759a62e9b7372997996dddd07d919a97d73ffdb"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.clear_highest_pole",
      "prefix": "theorem clear_highest_pole (n j : ℕ) (hj : j ≤ n) (t : ℚ)\n    (ht : ∀ k ≤ n, t + (k : ℚ) ≠ 0) :\n    actualR n t * (t + j) ^ 9 = clearedR n j t :=",
      "sha256_utf8": "677ac7a6c9abee46b4f1d96e05c5234b24ba8696f62e48ea05cc4e245d2d7d5e"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.clear_weighted_highest_pole",
      "prefix": "theorem clear_weighted_highest_pole (n j : ℕ) (hj : j ≤ n)\n    (W : ℚ[X]) (t : ℚ) (ht : ∀ k ≤ n, t + (k : ℚ) ≠ 0) :\n    weightedR n W t * (t + j) ^ 9 = clearedWeightedR n j W t :=",
      "sha256_utf8": "9fa88c83cb64d78a436d3a50efb71d2219719c7bb076506e0af9a51bfc9a856c"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.rising_product",
      "prefix": "theorem rising_product (a n : ℕ) :\n    (∏ i ∈ range n, ((a : ℚ) + ((i : ℚ) + 1))) =\n      (n.factorial : ℚ) * ((a + n).choose n : ℚ) :=",
      "sha256_utf8": "e8b5d9b0734ee6a5625d82c2db150c7b7473a4ea7d28171dac127a9ea8910bd5"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.falling_product",
      "prefix": "theorem falling_product (n : ℕ) :\n    (∏ k ∈ range n, ((k : ℚ) - n)) =\n      (-1 : ℚ) ^ n * (n.factorial : ℚ) :=",
      "sha256_utf8": "f77f2846defbb547917cdcdffe6d81b209455b73bb14da58108e495193218186"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.clearedPoleProduct_eval",
      "prefix": "theorem clearedPoleProduct_eval (n j : ℕ) (hj : j ≤ n) :\n    clearedPoleProduct n j (-(j : ℚ)) =\n      (-1 : ℚ) ^ j * (j.factorial : ℚ) * ((n - j).factorial : ℚ) :=",
      "sha256_utf8": "11445368d3dfaf8866d7f43f4971498809f489911f672dc3c7f765752d20f501"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.numerator_eval",
      "prefix": "theorem numerator_eval (n j : ℕ) (hj : j ≤ n) :\n    numerator n (-(j : ℚ)) =\n      (-1 : ℚ) ^ n * (n.factorial : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) :=",
      "sha256_utf8": "3292b741513482f1784fcccf3169992b7e62f8d4703722b7dfac0eed069f1dc8"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.leadingPoleCoefficient_eq",
      "prefix": "theorem leadingPoleCoefficient_eq (n j : ℕ) (hj : j ≤ n) :\n    leadingPoleCoefficient n j =\n      (-1 : ℚ) ^ (n + j) * (n.choose j : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) :=",
      "sha256_utf8": "b94f541c0f812c799e68a401f67f2feb21d32590a0e3e60c9b7a03ae591a9117"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.leadingPoleCoefficient_eq_even",
      "prefix": "theorem leadingPoleCoefficient_eq_even (n j : ℕ) (hn : Even n) (hj : j ≤ n) :\n    leadingPoleCoefficient n j =\n      (-1 : ℚ) ^ j * (n.choose j : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) :=",
      "sha256_utf8": "ef0da97eb776cdba487e31946bd1640b429dead3b9b460b8e07fd57541073830"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.leadingPoleCoefficient_ne_zero",
      "prefix": "theorem leadingPoleCoefficient_ne_zero (n j : ℕ) (hj : j ≤ n) :\n    leadingPoleCoefficient n j ≠ 0 :=",
      "sha256_utf8": "af69f84bcc097795f06caf9227594c9749969e7392f4c9f2a269976f887eac8d"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.leadingPoleCoefficient_is_integer",
      "prefix": "theorem leadingPoleCoefficient_is_integer (n j : ℕ) (hj : j ≤ n) :\n    ∃ z : ℤ, leadingPoleCoefficient n j = (z : ℚ) :=",
      "sha256_utf8": "6a1b58cfada9f4b659d84dc489f2b3bf3d3aec1af9159371bb6ecd6efc35f344"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.signed_leadingPoleCoefficient_pos_even",
      "prefix": "theorem signed_leadingPoleCoefficient_pos_even (n j : ℕ) (hn : Even n) (hj : j ≤ n) :\n    (-1 : ℚ) ^ j * leadingPoleCoefficient n j > 0 :=",
      "sha256_utf8": "d33ff37aa127690f92e282007326f25ad4466d8414532f25b14ee6cccaa5cd80"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.local_coordinate_identity",
      "prefix": "theorem local_coordinate_identity (n j : ℕ) (hj : j ≤ n) (z : ℚ) :\n    (-(j : ℚ) + z) * (-(j : ℚ) + z + n) =\n      -(j : ℚ) * (n - j : ℕ) + ((n : ℚ) - 2 * j) * z + z ^ 2 :=",
      "sha256_utf8": "c64814ed7d8dcca71007d92b4e8b6c09224520f51b947173cb6aef127957d33f"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.clearedWeightedR_local_coordinate",
      "prefix": "theorem clearedWeightedR_local_coordinate (n j : ℕ) (hj : j ≤ n)\n    (W : ℚ[X]) (z : ℚ) :\n    clearedWeightedR n j W (-(j : ℚ) + z) =\n      clearedR n j (-(j : ℚ) + z) *\n        W.eval (-(j : ℚ) * (n - j : ℕ) + ((n : ℚ) - 2 * j) * z + z ^ 2) :=",
      "sha256_utf8": "edbabfdbf00972f0402c09ed7cee7449a13291e9b5254ad3c91d9f71c7f303b6"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.weightedLeadingPoleCoefficient_eq",
      "prefix": "theorem weightedLeadingPoleCoefficient_eq (n j : ℕ) (hj : j ≤ n) (W : ℚ[X]) :\n    weightedLeadingPoleCoefficient n j W =\n      (-1 : ℚ) ^ (n + j) * (n.choose j : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) *\n          W.eval (-(j : ℚ) * (n - j : ℕ)) :=",
      "sha256_utf8": "72eefcb554f36551d9dbeb82c16abd37a19b4077d04f12815a717b9975424cdf"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.weightedLeadingPoleCoefficient_eq_even",
      "prefix": "theorem weightedLeadingPoleCoefficient_eq_even (n j : ℕ) (hn : Even n)\n    (hj : j ≤ n) (W : ℚ[X]) :\n    weightedLeadingPoleCoefficient n j W =\n      (-1 : ℚ) ^ j * (n.choose j : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) *\n          W.eval (-(j : ℚ) * (n - j : ℕ)) :=",
      "sha256_utf8": "f5aa07eb2daaff35187009e1e369bd77194a681827343ff5b3a771d9ccb23ec2"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.real_factorial_pos",
      "prefix": "theorem real_factorial_pos (n : ℕ) : 0 < (n.factorial : ℝ) :=",
      "sha256_utf8": "d0b78b9fd0494f6e1e2598050dedd636ec64d2dc78f033e5619d3714cbeccb85"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_factorial_succ",
      "prefix": "theorem log_factorial_succ (n : ℕ) :\n    Real.log ((n + 1).factorial : ℝ) =\n      Real.log ((n : ℝ) + 1) + Real.log (n.factorial : ℝ) :=",
      "sha256_utf8": "9df3fb57f6c80119194ad97873fa94fb2b4208a847bb719e221bc17fbad05aff"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_successor_increment_upper",
      "prefix": "theorem log_successor_increment_upper (n : ℕ) (hn : 1 ≤ n) :\n    (n : ℝ) * (Real.log ((n : ℝ) + 1) - Real.log (n : ℝ)) ≤ 1 :=",
      "sha256_utf8": "34162ba59d663c56b153563c8cad8fe8f7258e6e13cdff1b784038d3c7eb2127"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_successor_increment_lower",
      "prefix": "theorem log_successor_increment_lower (n : ℕ) (hn : 1 ≤ n) :\n    1 ≤ ((n : ℝ) + 1) *\n      (Real.log ((n : ℝ) + 1) - Real.log (n : ℝ)) :=",
      "sha256_utf8": "389feeee49d0fb21c8699e6caa6a1e532abbeb421ab6ac58fbe88f19db4b7d73"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_factorial_lower",
      "prefix": "theorem log_factorial_lower (n : ℕ) :\n    (n : ℝ) * Real.log (n : ℝ) - n ≤ Real.log (n.factorial : ℝ) :=",
      "sha256_utf8": "8898414c99c7aab6e29a86c30e27124fa265f94a673d12dfb56a2f48a1df3758"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_factorial_upper",
      "prefix": "theorem log_factorial_upper (n : ℕ) (hn : 1 ≤ n) :\n    Real.log (n.factorial : ℝ) ≤\n      ((n : ℝ) + 1) * Real.log (n : ℝ) - n + 1 :=",
      "sha256_utf8": "2be8a7204aecd9e642d2090707fa99a64cf42ed904d9ec9b2e7f201f5b24ba2e"
    },
    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_factorial_pred",
      "prefix": "theorem log_factorial_pred (n : ℕ) (hn : 1 ≤ n) :\n    Real.log ((n - 1).factorial : ℝ) =\n      Real.log (n.factorial : ℝ) - Real.log (n : ℝ) :=",
      "sha256_utf8": "117d9f5fb4f6d2e4b52a3a43961cd8699f73ca69cc540dca4b769b464d06e02a"
    },
    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.rational_factorial_ne_zero",
      "prefix": "theorem rational_factorial_ne_zero (n : ℕ) : (n.factorial : ℚ) ≠ 0 :=",
      "sha256_utf8": "3a93baaaa5cd0e3adf358748d248388cd26220ebf4a42548201465f5844efda5"
    },
    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.ascending_product_factorial",
      "prefix": "theorem ascending_product_factorial (a m : ℕ) (ha : 1 ≤ a) :\n    (∏ i ∈ range m, ((a : ℚ) + (i : ℚ))) =\n      ((a + m - 1).factorial : ℚ) / ((a - 1).factorial : ℚ) :=",
      "sha256_utf8": "939111cdbb4a5f5ea5aef2c6148d397e6283980847da8d838b6db34a4a4ea8a7"
    },
    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.actual_falling_product_factorial",
      "prefix": "theorem actual_falling_product_factorial (n k : ℕ) (hk : n < k) :\n    (∏ i ∈ range n, ((k : ℚ) - ((i : ℚ) + 1))) =\n      ((k - 1).factorial : ℚ) / ((k - n - 1).factorial : ℚ) :=",
      "sha256_utf8": "eb7c09b407b7e048978451e6833966b7630cbef4135bd15aae012f74cd815786"
    },
    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.actual_rising_product_factorial",
      "prefix": "theorem actual_rising_product_factorial (n k : ℕ) :\n    (∏ i ∈ range n, ((k : ℚ) + (n : ℚ) + ((i : ℚ) + 1))) =\n      ((k + 2 * n).factorial : ℚ) / ((k + n).factorial : ℚ) :=",
      "sha256_utf8": "8d844b3c822176c36477a53a04c7ee0fb039b1b49b2842f4bd693f9ebe8153b1"
    },
    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.actual_poleProduct_factorial",
      "prefix": "theorem actual_poleProduct_factorial (n k : ℕ) (hk : 1 ≤ k) :\n    CoefficientMap.poleProduct n (k : ℚ) =\n      ((k + n).factorial : ℚ) / ((k - 1).factorial : ℚ) :=",
      "sha256_utf8": "65791691499f0c48d54ff981c6b9cf8cfd9b42f4ea8a61dc62fdd3ddc47ae8b7"
    },
