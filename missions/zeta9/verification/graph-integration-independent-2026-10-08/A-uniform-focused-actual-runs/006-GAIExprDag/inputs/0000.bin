    },
    {
      "full_name": "ZetaNine.AnalyticWeightedBound.actualWeighted_norm_summable",
      "prefix": "theorem actualWeighted_norm_summable (n : ℕ) (hn : 1 ≤ n) (W : ℚ[X])\n    (hW : W.natDegree ≤ 4) :\n    Summable (fun m : ℕ => ‖actualWeightedSequence n W m‖) :=",
      "sha256_utf8": "af1e85fc3f66615c52a378e42ca8806274f41a5701f22c700bf9d72f64aa4eb9"
