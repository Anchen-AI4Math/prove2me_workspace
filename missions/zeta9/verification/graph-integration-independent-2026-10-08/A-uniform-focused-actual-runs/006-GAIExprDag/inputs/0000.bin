    {
      "full_name": "ZetaNine.AnalyticRationalFactorial.actualR_factorial",
      "prefix": "theorem actualR_factorial (n k : ℕ) (hk : n < k) :\n    CoefficientMap.actualR n (k : ℚ) =\n      (n.factorial : ℚ) ^ 7 * ((k - 1).factorial : ℚ) ^ 10 *\n        ((k + 2 * n).factorial : ℚ) /\n      (((k - n - 1).factorial : ℚ) * ((k + n).factorial : ℚ) ^ 10) :=",
