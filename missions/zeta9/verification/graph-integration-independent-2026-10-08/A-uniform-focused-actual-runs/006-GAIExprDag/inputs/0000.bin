    {
      "full_name": "ZetaNine.AnalyticFactorialBounds.log_successor_increment_lower",
      "prefix": "theorem log_successor_increment_lower (n : ℕ) (hn : 1 ≤ n) :\n    1 ≤ ((n : ℝ) + 1) *\n      (Real.log ((n : ℝ) + 1) - Real.log (n : ℝ)) :=",
