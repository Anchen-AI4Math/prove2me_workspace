    {
      "full_name": "ZetaNine.AnalyticMomentBounds.actual_tail_moment_sum_factorial_bound",
      "prefix": "theorem actual_tail_moment_sum_factorial_bound (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    (∑' m : ℕ, actualMomentTerm n r (m + 2 * n)) ≤\n      tailCoefficient n r / (2 * (n : ℝ)) ^ tailPower n r * (9 / 7 : ℝ) :=",
      "sha256_utf8": "037cdcf30f632c8a87177dde78cfaec76c97d8e282c353ec88d8fd9d3433d8ca"
    },
    {
      "full_name": "ZetaNine.AnalyticMomentBounds.actualMoment_eq_compact_add_tail",
      "prefix": "theorem actualMoment_eq_compact_add_tail (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    actualMoment n r = (∑ m ∈ range (2 * n - 1), actualMomentSequence n r m) +\n      ∑' m : ℕ, actualMomentTerm n r (m + 2 * n) :=",
      "sha256_utf8": "ceac3faaaa2906d8f1805a29e43606b50d20f713d99e6f4284d73ac7987ddece"
    },
    {
      "full_name": "ZetaNine.AnalyticMomentBounds.actualMoment_compact_add_factorial_tail_bound",
      "prefix": "theorem actualMoment_compact_add_factorial_tail_bound (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    actualMoment n r ≤\n      5184 * Real.exp 18 * (n : ℝ) ^ 10 * (n : ℝ) ^ (2 * r) *\n        Real.exp (-(2641 / 250 : ℝ) * n) +\n      tailCoefficient n r / (2 * (n : ℝ)) ^ tailPower n r * (9 / 7 : ℝ) :=",
      "sha256_utf8": "24763cdc753fd5332e434b27b53ef12ac37c974d765fe573da9b039cf31d32a1"
    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailWeightConstant_pos",
