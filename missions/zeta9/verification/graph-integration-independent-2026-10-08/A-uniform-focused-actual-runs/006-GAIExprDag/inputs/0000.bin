    {
      "full_name": "ZetaNine.AnalyticWeightedBound.actualWeighted_tsum_eq_actual_moment_sum",
      "prefix": "theorem actualWeighted_tsum_eq_actual_moment_sum (n : ℕ) (hn : 1 ≤ n) (W : ℚ[X])\n    (hW : W.natDegree ≤ 4) :\n    (∑' m : ℕ, actualWeightedSequence n W m) =\n      ∑ r ∈ range 5, (W.coeff r : ℝ) * actualMoment n r :=",
      "sha256_utf8": "c88abc4364b06caf76ee799f224a51973ad7a71f9cc798a054f031ae3309d7eb"
    },
    {
      "full_name": "ZetaNine.AnalyticWeightedBound.actualMoment_nonneg",
      "prefix": "theorem actualMoment_nonneg (n r : ℕ) : 0 ≤ actualMoment n r :=",
