      "prefix": "theorem clear_weighted_highest_pole (n j : ℕ) (hj : j ≤ n)\n    (W : ℚ[X]) (t : ℚ) (ht : ∀ k ≤ n, t + (k : ℚ) ≠ 0) :\n    weightedR n W t * (t + j) ^ 9 = clearedWeightedR n j W t :=",
      "sha256_utf8": "9fa88c83cb64d78a436d3a50efb71d2219719c7bb076506e0af9a51bfc9a856c"
    },
    {
      "full_name": "ZetaNine.CoefficientMap.rising_product",
      "prefix": "theorem rising_product (a n : ℕ) :\n    (∏ i ∈ range n, ((a : ℚ) + ((i : ℚ) + 1))) =\n      (n.factorial : ℚ) * ((a + n).choose n : ℚ) :=",
      "sha256_utf8": "e8b5d9b0734ee6a5625d82c2db150c7b7473a4ea7d28171dac127a9ea8910bd5"
    },
    {
