    },
    {
      "full_name": "ZetaNine.CoefficientMap.numerator_eval",
      "prefix": "theorem numerator_eval (n j : ℕ) (hj : j ≤ n) :\n    numerator n (-(j : ℚ)) =\n      (-1 : ℚ) ^ n * (n.factorial : ℚ) ^ 9 *\n        ((n + j).choose n : ℚ) * ((2 * n - j).choose n : ℚ) :=",
      "sha256_utf8": "3292b741513482f1784fcccf3169992b7e62f8d4703722b7dfac0eed069f1dc8"
    },
