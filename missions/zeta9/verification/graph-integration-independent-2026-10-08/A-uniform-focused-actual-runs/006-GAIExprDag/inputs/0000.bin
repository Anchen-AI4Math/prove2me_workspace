    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.actualMoment_uniform_bound",
      "prefix": "theorem actualMoment_uniform_bound (n r : ℕ) (hn : 1 ≤ n) (hr : r ≤ 4) :\n    actualMoment n r ≤ momentBoundConstant * ((n : ℝ) + 1) ^ 10 *\n      Real.exp (-(2641 / 250 : ℝ) * n) * (n : ℝ) ^ (2 * r) :=",
      "sha256_utf8": "0fc44ae98c85de1619337c2a117381bd2d44b93a7d3db13754cebaf149774fe7"
    },
    {
      "full_name": "ZetaNine.AnalyticWeightedBound.actualWeightedSequence_eq_actual_moment_sum",
      "prefix": "theorem actualWeightedSequence_eq_actual_moment_sum (n : ℕ) (W : ℚ[X])\n    (hW : W.natDegree ≤ 4) (m : ℕ) :\n    actualWeightedSequence n W m =\n      ∑ r ∈ range 5, (W.coeff r : ℝ) * actualMomentSequence n r m :=",
