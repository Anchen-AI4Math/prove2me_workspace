      "prefix": "theorem ascending_product_factorial (a m : ℕ) (ha : 1 ≤ a) :\n    (∏ i ∈ range m, ((a : ℚ) + (i : ℚ))) =\n      ((a + m - 1).factorial : ℚ) / ((a - 1).factorial : ℚ) :=",
