      "prefix": "theorem clear_highest_pole (n j : ℕ) (hj : j ≤ n) (t : ℚ)\n    (ht : ∀ k ≤ n, t + (k : ℚ) ≠ 0) :\n    actualR n t * (t + j) ^ 9 = clearedR n j t :=",
