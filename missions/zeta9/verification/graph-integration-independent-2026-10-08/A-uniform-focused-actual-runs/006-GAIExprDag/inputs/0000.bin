    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailWeightConstant_le",
      "prefix": "theorem tailWeightConstant_le (r : ℕ) (hr : r ≤ 4) :\n    tailWeightConstant r ≤ (729 / 224 : ℝ) :=",
      "sha256_utf8": "fe323e61895462cb16ef9938c670b3743b74ab0d560387fd4e5b10a80a3d5cba"
    },
    {
      "full_name": "ZetaNine.AnalyticUniformMomentBound.tailMajorant_pos",
      "prefix": "theorem tailMajorant_pos (n r : ℕ) (hn : 1 ≤ n) : 0 < tailMajorant n r :=",
