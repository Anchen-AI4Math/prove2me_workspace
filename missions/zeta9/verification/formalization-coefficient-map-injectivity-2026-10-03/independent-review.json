        "actual_definition_values": {
          "ZetaNine.CoefficientMapInjectivity.baseNumerator": "fun n =>\n  (Polynomial.C (↑n.factorial ^ 7) * ∏ i ∈ Finset.range n, (Polynomial.X - Polynomial.C (↑i + 1))) *\n    ∏ i ∈ Finset.range n, (Polynomial.X + Polynomial.C ↑n + Polynomial.C (↑i + 1))",
          "ZetaNine.CoefficientMapInjectivity.baseU": "fun n => Polynomial.X * (Polynomial.X + Polynomial.C ↑n)",
          "ZetaNine.CoefficientMapInjectivity.weightedNumerator": "fun n W => ZetaNine.CoefficientMapInjectivity.baseNumerator n * W.comp (ZetaNine.CoefficientMapInjectivity.baseU n)",
          "ZetaNine.CoefficientMapInjectivity.polePolynomial": "fun n => ∏ j ∈ Finset.range (n + 1), (Polynomial.X + Polynomial.C ↑j)",
          "ZetaNine.CoefficientMapInjectivity.AllLocalCoefficientsZero": "fun n W => ∀ j ≤ n, ∀ (s : ℕ), 1 ≤ s → s ≤ 9 → ZetaNine.CoefficientMapJet.weightedLocalCoefficient n j s W = 0",
          "ZetaNine.CoefficientMapInjectivity.ProperMultiplier": "fun n W => 2 * n + 2 * W.natDegree < 9 * (n + 1)",
          "ZetaNine.CoefficientMapInjectivity.fullLocalCoefficientMap": "fun n W j s => ZetaNine.CoefficientMapJet.weightedLocalCoefficient n (↑j) (↑s + 1) W"
        },
        "all_source_type_and_value_outputs_equal_frozen_author_report": true
      }
