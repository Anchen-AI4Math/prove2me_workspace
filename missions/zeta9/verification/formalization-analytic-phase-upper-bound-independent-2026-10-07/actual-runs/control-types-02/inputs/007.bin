  "expected_theorem_prefixes": {
    "phaseGap_identity": "theorem phaseGap_identity (x : ℝ) :\n    (x - 1) * (x + 1) ^ 10 - (x + 2) * x ^ 10 =\n    (743876235460997060507 / 100000000000000000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 0 +\n    (109589356802878649457 / 100000000000000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 1 +\n    (10634683646357555663 / 2000000000000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 2 +\n    (29280046551142071 / 2500000000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 3 +\n    (1524457114482447 / 100000000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 4 +\n    (32277046531191 / 2500000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 5 +\n    (73792828347 / 10000000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 6 +\n    (71169471 / 25000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 7 +\n    (1428963 / 2000 : ℝ) * (x - (101 / 100 : ℝ)) ^ 8 +\n    (1057 / 10 : ℝ) * (x - (101 / 100 : ℝ)) ^ 9 +\n    (7 / 1 : ℝ) * (x - (101 / 100 : ℝ)) ^ 10 :=",
    "phaseGap_pos": "theorem phaseGap_pos (x : ℝ) (hx : (101 / 100 : ℝ) ≤ x) :\n    0 < (x - 1) * (x + 1) ^ 10 - (x + 2) * x ^ 10 :=",
    "phaseRatio_pos": "theorem phaseRatio_pos (x : ℝ) (hx : 1 < x) : 0 < phaseRatio x :=",
    "phaseRatio_lt_one": "theorem phaseRatio_lt_one (x : ℝ) (hx : (101 / 100 : ℝ) ≤ x) :\n    phaseRatio x < 1 :=",
    "phaseSlope_eq_log_ratio": "theorem phaseSlope_eq_log_ratio (x : ℝ) (hx : 1 < x) :\n    phaseSlope x = Real.log (phaseRatio x) :=",
    "phaseSlope_neg_right": "theorem phaseSlope_neg_right (x : ℝ) (hx : (101 / 100 : ℝ) ≤ x) :\n    phaseSlope x < 0 :=",
    "hasDerivAt_mul_log_shift": "theorem hasDerivAt_mul_log_shift (x a : ℝ) (ha : x + a ≠ 0) :\n    HasDerivAt (fun y : ℝ => (y + a) * Real.log (y + a))\n      (Real.log (x + a) + 1) x :=",
    "phase_hasDerivAt": "theorem phase_hasDerivAt (x : ℝ) (hx : 1 < x) :\n    HasDerivAt phase (phaseSlope x) x :=",
    "deriv_phase": "theorem deriv_phase (x : ℝ) (hx : 1 < x) : deriv phase x = phaseSlope x :=",
    "phase_strictAntiOn_right": "theorem phase_strictAntiOn_right : StrictAntiOn phase (Ici (101 / 100 : ℝ)) :=",
    "phase_le_right_endpoint": "theorem phase_le_right_endpoint (x : ℝ) (hx : (101 / 100 : ℝ) ≤ x) :\n    phase x ≤ phase (101 / 100) :=",
    "upperSlopeConstant_pos": "theorem upperSlopeConstant_pos : 0 < upperSlopeConstant :=",
    "upperSlopeConstant_eq": "theorem upperSlopeConstant_eq : upperSlopeConstant =\n    (33249125974877255751301 / 10763674952097696180200100 : ℝ) :=",
    "phaseRatio_small_interval_le": "theorem phaseRatio_small_interval_le (u : ℝ) (hu : 0 < u)\n    (hu1 : u ≤ (1 / 100 : ℝ)) : phaseRatio (1 + u) ≤ upperSlopeConstant / u :=",
    "phaseSlope_small_interval_le": "theorem phaseSlope_small_interval_le (u : ℝ) (hu : 0 < u)\n    (hu1 : u ≤ (1 / 100 : ℝ)) : phaseSlope (1 + u) ≤ Real.log (upperSlopeConstant / u) :=",
    "phase_one_eq": "theorem phase_one_eq : phase 1 = 3 * Real.log 3 - 20 * Real.log 2 :=",
    "smoothPhaseGap_one": "theorem smoothPhaseGap_one : smoothPhaseGap 1 = 0 :=",
    "smoothPhaseGap_hasDerivAt": "theorem smoothPhaseGap_hasDerivAt (x : ℝ) (hx : 1 ≤ x) :\n    HasDerivAt smoothPhaseGap (smoothPhaseSlope x) x :=",
    "smoothPhaseRatio_pos": "theorem smoothPhaseRatio_pos (x : ℝ) (hx : 1 ≤ x) :\n    0 < smoothPhaseRatio x :=",
    "smoothPhaseRatio_le_upperSlopeConstant": "theorem smoothPhaseRatio_le_upperSlopeConstant (x : ℝ)\n    (hx : x ∈ Icc (1 : ℝ) (101 / 100 : ℝ)) :\n    smoothPhaseRatio x ≤ upperSlopeConstant :=",
    "smoothPhaseSlope_eq_log_ratio": "theorem smoothPhaseSlope_eq_log_ratio (x : ℝ) (hx : 1 ≤ x) :\n    smoothPhaseSlope x =\n      Real.log (smoothPhaseRatio x) - Real.log upperSlopeConstant :=",
    "smoothPhaseSlope_nonpos": "theorem smoothPhaseSlope_nonpos (x : ℝ)\n    (hx : x ∈ Icc (1 : ℝ) (101 / 100 : ℝ)) :\n    smoothPhaseSlope x ≤ 0 :=",
    "smoothPhaseGap_antitoneOn": "theorem smoothPhaseGap_antitoneOn :\n    AntitoneOn smoothPhaseGap (Icc (1 : ℝ) (101 / 100 : ℝ)) :=",
    "smoothPhaseGap_le_zero": "theorem smoothPhaseGap_le_zero (x : ℝ)\n    (hx : x ∈ Icc (1 : ℝ) (101 / 100 : ℝ)) :\n    smoothPhaseGap x ≤ 0 :=",
    "mul_one_add_log_div_le": "theorem mul_one_add_log_div_le (a u : ℝ) (ha : 0 < a) (hu : 0 < u) :\n    u * (1 + Real.log (a / u)) ≤ a :=",
    "phase_small_interval_identity": "theorem phase_small_interval_identity (u : ℝ) (hu : 0 < u) :\n    phase (1 + u) = phase 1 +\n      u * (1 + Real.log (upperSlopeConstant / u)) + smoothPhaseGap (1 + u) :=",
    "phase_small_interval_le_one_add_constant": "theorem phase_small_interval_le_one_add_constant (u : ℝ) (hu : 0 < u)\n    (hu1 : u ≤ (1 / 100 : ℝ)) :\n    phase (1 + u) ≤ phase 1 + upperSlopeConstant :=",
    "phase_global_le_one_add_constant": "theorem phase_global_le_one_add_constant (x : ℝ) (hx : 1 < x) :\n    phase x ≤ phase 1 + upperSlopeConstant :=",
    "log_two_lower_rational": "theorem log_two_lower_rational : (693147 / 1000000 : ℝ) < Real.log 2 :=",
    "log_three_upper_rational": "theorem log_three_upper_rational : Real.log 3 < (1098613 / 1000000 : ℝ) :=",
    "upperSlopeConstant_lt_rational": "theorem upperSlopeConstant_lt_rational :\n    upperSlopeConstant < (309 / 100000 : ℝ) :=",
    "phase_one_add_constant_lt_certified": "theorem phase_one_add_constant_lt_certified :\n    phase 1 + upperSlopeConstant < (-10564011 / 1000000 : ℝ) :=",
    "phase_global_lt_certified": "theorem phase_global_lt_certified (x : ℝ) (hx : 1 < x) :\n    phase x < (-10564011 / 1000000 : ℝ) :=",
    "phase_global_upper_bound": "theorem phase_global_upper_bound :\n    ∀ x : ℝ, 1 < x → phase x ≤ (-2641 / 250 : ℝ) :="
  },
  "original_full_definition_source": {
    "phase": "def phase (x : ℝ) : ℝ :=\n  10 * x * Real.log x + (x + 2) * Real.log (x + 2) -\n    (x - 1) * Real.log (x - 1) - 10 * (x + 1) * Real.log (x + 1)",
    "phaseRatio": "def phaseRatio (x : ℝ) : ℝ := (x + 2) * x ^ 10 / ((x - 1) * (x + 1) ^ 10)",
    "phaseSlope": "def phaseSlope (x : ℝ) : ℝ :=\n  10 * Real.log x + Real.log (x + 2) - Real.log (x - 1) - 10 * Real.log (x + 1)",
    "upperSlopeConstant": "def upperSlopeConstant : ℝ := (301 / 100 : ℝ) * (101 / 201 : ℝ) ^ 10",
    "smoothPhaseGap": "def smoothPhaseGap (x : ℝ) : ℝ :=\n  10 * x * Real.log x + (x + 2) * Real.log (x + 2) -\n    10 * (x + 1) * Real.log (x + 1) - phase 1 -\n      (x - 1) * (1 + Real.log upperSlopeConstant)",
    "smoothPhaseSlope": "def smoothPhaseSlope (x : ℝ) : ℝ :=\n  10 * Real.log x + Real.log (x + 2) - 10 * Real.log (x + 1) -\n    Real.log upperSlopeConstant",
    "smoothPhaseRatio": "def smoothPhaseRatio (x : ℝ) : ℝ :=\n  (x + 2) * (x / (x + 1)) ^ 10"
  },
  "theorem_count": 34,
