def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def trim(p):
 p=[F(x) for x in p]
 while p and not p[-1]:p.pop()
 return p

def add(p,q):return trim([(p[i] if i<len(p) else 0)+(q[i] if i<len(q) else 0) for i in range(max(len(p),len(q)))])
def scale(p,c):return trim([x*c for x in p])
def sub(p,q):return add(p,scale(q,-1))
def mul(p,q):
 if not p or not q:return []
 a=[F(0)]*(len(p)+len(q)-1)
 for i,x in enumerate(p):
  for j,y in enumerate(q):a[i+j]+=x*y
 return trim(a)
def power(p,n):
 r=[F(1)]
 for _ in range(n):r=mul(r,p)
 return r
def ev(p,t):
 r=F(0)
 for c in p[::-1]:r=r*t+c
 return r
def comp(p,q):
 r=[]
 for c in p[::-1]:r=add(mul(r,q),[c])
 return r
def coeff(p,i):return p[i] if i<len(p) else F(0)
def degree(p):return max(0,len(p)-1)
def rational(f):return str(f)
def R(n,t):
 return F(factorial(n)**7)*prod((t-k for k in range(1,n+1)),start=F(1))*prod((t+n+k for k in range(1,n+1)),start=F(1))/prod((t+k for k in range(n+1)),start=F(1))**9
def reg(n,t):return all(t-1+k for k in range(n+3))
def q_remainder(n,q,t):
 return R(n,t)*(t-n-1)/(t-1)**10*ev(q,t*(t+max(n-1,0)))
def maps(n):
 U=[0,n,1];V=[0,max(n-1,0),1];W=mul([1,1],[n,1])
 D=power(sub(U,[n+1]),10)
 front=mul([-(n+1),1],power([n+1,1],10))
 back=mul([2*n+1,1],power([-1,1],10))
 Z=[F(1)]
 for a in [1,2,3]:Z=mul(Z,[-(n+a)*(2*n+a),1])
 return U,V,W,D,front,back,Z

def solve_targets(n):
 U,V,W,D,front,back,Z=maps(n)
 cols=[mul(D,power(U,i)) for i in range(5)]+[
  sub(mul(front,power(V,a)),mul(back,power(W,a))) for a in range(10)]
 targets=[scale(mul(comp(Z,U),power(sub(U,[n+1]),r)),((n+1)*(n+2))**7) for r in range(5)]
 matrix=[[coeff(c,2*i) for c in cols]+[coeff(c,2*i) for c in targets] for i in range(15)]
 pivots=[]
 for j in range(15):
  k=next((k for k in range(j,15) if matrix[k][j]),None);assert k is not None
  matrix[j],matrix[k]=matrix[k],matrix[j]
  pivot=matrix[j][j];pivots.append(rational(pivot))
  matrix[j]=[x/pivot for x in matrix[j]]
  for k in range(15):
   if k==j:continue
   c=matrix[k][j]
   if c:matrix[k]=[x-c*y for x,y in zip(matrix[k],matrix[j])]
 results=[]
 for r in range(5):
  c=[matrix[i][15+r] for i in range(15)];P=trim(c[:5]);q=trim(c[5:])
  lhs=add(mul(D,comp(P,U)),sub(mul(front,comp(q,V)),mul(back,comp(q,W))))
  assert lhs==targets[r]  # Entire polynomial, all degrees; no projection-only gate.
  assert degree(P)<=4 and degree(q)<=9
  point_checks=[]
  for t in [F(1,2),F(-1,2),F(n+3)]+[F(k) for k in range(2,n+1)]:
   assert reg(n,t)
   u=t*(t+n)
   left=R(n+2,t-1)*(u-(n+1))**r
   right=R(n,t)*ev(P,u)+q_remainder(n,q,t)-q_remainder(n,q,t+1)
   assert left==right
   point_checks.append({'t':rational(t),'left':rational(left),'right':rational(right),'R_old_is_zero':R(n,t)==0})
  results.append({'n':n,'r':r,'P_coefficients':[rational(x) for x in P],
   'q_coefficients':[rational(x) for x in q],'P_degree':degree(P),'q_degree':degree(q),
   'whole_polynomial_residual_zero':True,'actual_rational_transport_points':point_checks})
 return {'n':n,'all_15_exact_pivots_nonzero':True,'pivots':pivots,'solutions':results}

