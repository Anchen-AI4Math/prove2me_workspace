    "OAI.PiExponent.LiteralAnalytic.analyticAggregate": {
      "http_status": 200,
      "body": {
        "id": "0f7ad576-61eb-47ed-9ab4-b3a802db16ef",
        "kind": "problem",
        "theorem_name": "OAI.PiExponent.LiteralAnalytic.analyticAggregate",
        "theorem_title": "The original analytic aggregate bound for admissible selected minors",
        "formal_statement": "theorem OAI.PiExponent.LiteralAnalytic.analyticAggregate : AnalyticAggregateStatement := by\n  sorry\n",
        "natural_language_statement": "For every real $\\nu>2$ and fixed admissible datum $d$, there is an error $e_d(H)\\to0$ as $H\\to+\\infty$. Eventually, every selected minor $D$ with nonzero determinant satisfies\n\n$$\\frac{\\log\\|\\det D\\|}{M_d(H)H}\\le a_d+e_d(H)+\\max\\{-\\gamma_d(H),-\\nu[A_d(1-\\eta_d)-b_d(H)]\\}.$$\n\nHere $M_d(H)$ is the row count, $a_d$ the analytic error parameter, $\\gamma_d(H)$ the collision rate, $A_d$ and $\\eta_d$ the fixed-data parameters, and $b_d(H)$ the normalized weighted row mean. The bound is uniform over the original column selections and is precisely the source analytic aggregate statement.",
        "definitions": "import Definitions.Def_OAI_PiExponent_ApproximationDefinitions\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_DeterminantContradiction_CoreData\n\nopen OAI.PiExponent OAI.PiExponent.DeterminantContradiction\n\n",
        "source": "https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Analysis/AnalyticAggregate.lean#L96-L101",
