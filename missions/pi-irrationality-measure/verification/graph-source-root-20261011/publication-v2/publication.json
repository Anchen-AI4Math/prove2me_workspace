    "OAI.PiExponent.AdmissibleMatrixInterpolation.globalInterpolation": {
      "http_status": 200,
      "body": {
        "id": "d3c2a656-9acf-408b-bdef-a79ff8473c84",
        "kind": "problem",
        "theorem_name": "OAI.PiExponent.AdmissibleMatrixInterpolation.globalInterpolation",
        "theorem_title": "Global surjectivity of the original admissible interpolation matrix",
        "formal_statement": "theorem OAI.PiExponent.AdmissibleMatrixInterpolation.globalInterpolation : GlobalInterpolationStatement := by\n  sorry\n",
        "natural_language_statement": "For every real $\\nu>2$, every fixed admissible datum $d$, and every real lower height $L$, the original interpolation matrix $A_d(H)$ is surjective at some height $H\\ge L$:\n\n$$\\forall\\nu>2\\;\\forall d\\;\\forall L\\in\\mathbb R\\;\\exists H\\ge L,\\quad\\operatorname{Surjective}(A_d(H)).$$\n\nHere the matrix, its weighted row and column domains, and the fixed-data parameters are exactly those of the source global interpolation statement.",
        "definitions": "import Definitions.Def_OAI_PiExponent_ApproximationDefinitions\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_DeterminantContradiction_CoreData\n\nopen OAI.PiExponent OAI.PiExponent.DeterminantContradiction\n\n",
        "source": "https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44",
        "tags": [
