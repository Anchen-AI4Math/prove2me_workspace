  "preamble": "import Mathlib.Tactic.Linarith\nimport Mathlib.Topology.Instances.Real.Lemmas\n\nnamespace OAI\nnamespace PiExponent\nopen Filter Topology\n\n",
  "formal_statement": "theorem determinant_bounds_inconsistent\r\n    (nu theta x b ear ean err collision d : ℝ)\r\n    (hnu : 1 < nu) (hb0 : 0 ≤ b) (hb : b ≤ theta)\r\n    (hgap : ear + ean + err < nu * (x - theta) - (1 - theta))\r\n    (hcollision : 1 + ear + ean + err < collision)\r\n    (hlower : -(1 - b) - ear ≤ d)\r\n    (hupper : d ≤ ean + err + max (-collision) (-nu * (x - b))) : False := by\n  sorry\n\nend PiExponent\nend OAI\n",
  "compiled_statement_assembly_sha256": "99fff86610183488adc12bc35da96ea97ca4c136dc422185ce0af040b4a6e4c1",
