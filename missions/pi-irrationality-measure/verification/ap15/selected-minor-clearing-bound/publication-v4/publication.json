row count, $D$ the source common denominator, and $C_{\\mathrm{col}},C_{\\mathrm{row}}$ the source column and row costs,\n\n$$-r\\log D-C_{\\mathrm{col}}+C_{\\mathrm{row}}\\leq\\log\\lVert\\det M_{\\mathrm{sel}}\\rVert.$$","preamble":"import Mathlib.Tactic\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_InterpolationMatrix_CoreData\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_MatrixArithmetic_CoreData\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_DeterminantContradiction_CoreData\nimport Definitions.Def_OAI_NumberTheory_PiExponent_Approximation_MatrixArithmetic_ScalesCosts\nimport Theorems.Thm_OAI_PiExponent_InterpolationMatrix_entry_truncatedLog_cleared_gaussian\n\nopen OAI.PiExponent OAI.PiExponent.MatrixArithmetic\nopen scoped BigOperators\n\n","readback":null,"source":"https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/MatrixArithmetic.lean#L337-L358","status":"Proved","tags":["linear-algebra","number-theory","openai-pi-exponent-017"],"theorem_id":"922467c8-68a8-4256-9a01-ee896d0f153e","theorem_name":"OAI.PiExponent.MatrixArithmetic.selectedMinor_clearing_bound","theorem_title":"A denominator-clearing lower bound for a selected interpolation minor","visibility":"public","vote_count":0},"http_status":200},"theorem_id":"922467c8-68a8-4256-9a01-ee896d0f153e","theorem_name":"OAI.PiExponent.MatrixArithmetic.selectedMinor_clearing_bound","updated_at_utc":"2026-10-11T15:44:04.866429+00:00","verify_intent":{"at_utc":"2026-10-11T15:38:13.557543+00:00","content_type":"multipart/form-data; boundary=----p2mBoundary7f3a9c2b","descriptor_sha256":"04324d8c4fad99f538a3b7309ea7860fd44a316991a320e1605b1b35a3209a0e","multipart_sha256":"eec8415aa8c317d00ece62aa661d1541a84d448e3c26f575f5997af4da35018b","solution_sha256":"cec31a9bc4079e11337e402d3dee2fc060d8aa8905c4d6ef6faf1f826b2c1b63","theorem_id":"922467c8-68a8-4256-9a01-ee896d0f153e"},"verify_respons